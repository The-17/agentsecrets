{
  "name": "@the-17/agentsecrets-plugin",
  "version": "0.1.0",
  "description": "Zero-knowledge credential tool for AI agent frameworks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./dsh": {
      "types": "./dist/dsh.d.ts",
      "import": "./dist/dsh.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "tsc -p tsconfig.tests.json",
    "test": "node --test \"dist-tests/tests/*.test.js\"",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','dist-tests'])fs.rmSync(d,{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-17/agentsecrets.git"
  }
}
