{
  "name": "@the-17/agentsecrets-mcp",
  "version": "1.1.0",
  "description": "AgentSecrets MCP bridge — zero-knowledge credential tools for AI agents (Model Context Protocol, stdio)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentsecrets-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "tsc -p tsconfig.tests.json",
    "test": "node --test \"dist-tests/tests/*.test.js\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('dist-tests',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-17/agentsecrets.git",
    "directory": "integrations/mcp"
  },
  "keywords": [
    "agentsecrets",
    "mcp",
    "model-context-protocol",
    "secrets",
    "zero-knowledge"
  ]
}
